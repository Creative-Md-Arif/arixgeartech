# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/arixgear
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional integrations
CLOUDINARY_URL=
RESEND_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=off
SMS_DRY_RUN=true
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
ADMIN_NOTIFY_EMAIL=
GEMINI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
