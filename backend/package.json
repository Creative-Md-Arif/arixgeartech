{
  "name": "arixgear-api",
  "version": "1.0.0",
  "description": "arixgear.tech e-commerce REST API — catalog v2, deals & promotions, AI assistant (import/RAG chat), SSLCOMMERZ + manual payments, Cloudinary/local uploads, Resend email, guest orders, division-wise BD shipping, after-sales, realtime",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "seed": "node src/seed/seed.js",
    "seed:categories": "node src/scripts/seed-categories.js",
    "seed:category-spec-schemas": "node src/scripts/seed-category-spec-schemas.js",
    "seed:accessories-spec-schema": "node src/scripts/seed-accessories-spec-schema.js",
    "seed:home-metadata": "node src/scripts/seed-home-section-metadata.js",
    "migrate:home-combo-config": "node src/scripts/migrate-home-combo-config.js",
    "migrate:community-sections": "node src/scripts/migrate-community-sections.js",
    "seed:quick-services": "node src/scripts/seed-quick-services.js",
    "seed:laptop-spec-schema": "node src/scripts/seed-laptop-spec-schema.js",
    "seed:earbuds-spec-schema": "node src/scripts/seed-earbuds-spec-schema.js",
    "mongo": "node scripts/dev-mongo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=18"
  }
}
